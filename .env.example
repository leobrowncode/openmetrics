# Postgres (Neon, Supabase, Vercel Postgres…). Absent = base PGlite embarquée (local/démo uniquement).
DATABASE_URL=

# Base PGlite persistée sur disque (local). Absent = en mémoire.
PGLITE_DATA_DIR=.data/pglite

# 32 octets en hex ou base64 : openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Secret HMAC des empreintes de liens privés et sessions : openssl rand -hex 32
TOKEN_HASH_SECRET=

# Premier administrateur, créé si aucun admin n'existe (mot de passe ≥ 12 caractères).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Protège /api/cron/sync (Vercel l'envoie en Bearer). ≥ 16 caractères.
CRON_SECRET=

# Meta Marketing API
META_GRAPH_API_VERSION=v24.0
# App Meta de l'agence : active « Se connecter avec Facebook » (ads_read) et appsecret_proof.
META_APP_ID=
META_APP_SECRET=
# Optionnel : configuration Facebook Login for Business (token d'utilisateur système, sans expiration).
META_LOGIN_CONFIG_ID=

# URL publique utilisée dans les liens privés (sinon déduite de la requête).
APP_URL=

# true = crée clients, comptes et dashboards synthétiques sur une base vide.
DEMO_MODE=false
